# ─────────────────────────────────────────────────────────────
# FBA Arbitrage Finder — API keys
# ─────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file to ".env"      ->   cp .env.example .env
#   2. Paste your real keys below (only the ones you have).
#   3. Restart the app (python run.py). Verify at /api/config that
#      the connectors you configured show "live": true.
#
# SECURITY: ".env" is git-ignored — NEVER commit it and NEVER paste
# these keys into a chat or issue. Leave a line blank to skip that
# connector (it will keep using sample data).
# ─────────────────────────────────────────────────────────────

# ── Amazon analytics ─────────────────────────────────────────
# Keepa — price history, sales rank, sales estimate (matches by UPC,
# and by title when there is no UPC).  https://keepa.com/#!api
KEEPA_API_KEY=
KEEPA_DOMAIN=1                 # 1=amazon.com, 2=.co.uk, 3=.de, 4=.fr ...
KEEPA_MATCH_THRESHOLD=0.35     # min title similarity when no UPC (0-1)

# Jungle Scout — sales estimates (needs BOTH values).
# https://developer.junglescout.com
JUNGLESCOUT_API_KEY=
JUNGLESCOUT_KEY_NAME=
JUNGLESCOUT_MARKETPLACE=us

# Helium 10 — sales estimates. Set the URL to your real endpoint.
HELIUM10_API_KEY=
HELIUM10_API_URL=
HELIUM10_MARKETPLACE=US

# SellerAmp (SAS) — sales estimates. Set the URL to your real endpoint.
SELLERAMP_API_KEY=
SELLERAMP_API_URL=

# ── Source retailers ─────────────────────────────────────────
# Walmart — official Walmart.io API (signed with your RSA private key).
# Provide the key inline OR as a file path (one of the two).
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY_FILE=      # e.g. /home/you/keys/walmart_private.pem
# WALMART_PRIVATE_KEY=         # or paste the PEM inline (multi-line not ideal)
WALMART_KEY_VERSION=1
WALMART_QUERIES=clearance,rollback

# SerpApi — used for Home Depot, Target, Costco, Sam's Club (and Walmart
# as a fallback). https://serpapi.com
SERPAPI_KEY=
SERPAPI_QUERIES=clearance,open box

# ── Misc ─────────────────────────────────────────────────────
# FBA_SETTINGS_FILE=           # optional: path for saved fee overrides
